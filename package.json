{
  "name": "stroxx-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .ts,.tsx app components lib sanity scripts",
    "check": "tsc --noEmit && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "sanity exec scripts/seed-demo.ts --with-user-token",
    "seed:more": "sanity exec scripts/seed-home-stores.ts --with-user-token",
    "seed:news": "sanity exec scripts/seed-news.ts --with-user-token",
    "seed:support": "sanity exec scripts/seed-support.ts --with-user-token",
    "seed:videos": "sanity exec scripts/seed-videos.ts --with-user-token",
    "seed:service": "sanity exec scripts/seed-service-copy.ts --with-user-token",
    "seed:markets": "sanity exec scripts/seed-markets.ts --with-user-token",
    "seed:i18n-base": "sanity exec scripts/seed-i18n-base.ts --with-user-token",
    "seed:proevdet": "sanity exec scripts/seed-proevdet.ts --with-user-token",
    "migrate:market-ops": "sanity exec scripts/migrate-market-ops.ts --with-user-token",
    "migrate:english-slugs": "sanity exec scripts/migrate-english-slugs.ts --with-user-token",
    "seed:qr": "sanity exec scripts/seed-qr.ts --with-user-token",
    "backup": "mkdir -p backups && sanity dataset export demo backups/demo-backup.tar.gz --overwrite"
  },
  "dependencies": {
    "@sanity/client": "^7.23.0",
    "@sanity/document-internationalization": "^6.2.17",
    "@sanity/image-url": "^1.2.0",
    "@types/leaflet": "^1.9.21",
    "gsap": "3.12.5",
    "leaflet": "^1.9.4",
    "lenis": "1.1.9",
    "lucide-react": "0.460.0",
    "next": "16.2.10",
    "next-sanity": "^13.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanity": "^6.3.0",
    "sharp": "0.33.4",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
