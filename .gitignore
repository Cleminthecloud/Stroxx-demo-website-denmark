# internal-only material — do NOT commit
# (/docs/* + negation instead of /docs: git cannot re-include a file inside an
#  excluded DIRECTORY, only inside an excluded glob. The editor guide must ship:
#  the /guide route and the Studio's Guide tab read it at runtime on Vercel.)
/INFO
/docs/*
!/docs/STROXX-editor-guide.md
/lib/_products.txt

# scratch
_checkslug.ts

# heavy campaign source originals (~8MB each) — the site ships the optimised
# copies in /public/Images/campaign/. Keep these locally, don't deploy them.
/public/Images/Campaign images/

# content backups (npm run backup)
backups/

# client handover pack (portable copy for Dropbox — not part of the app)
/Client Handover - Carl Ras/

# MMEXO video masters from Meena (~600MB), hosted in Sanity via npm run seed:videos,
# never committed. Kept locally to re-run the seed.
/Meena videos/

/_to_delete/
.env*

# leavings of scripts/build-handover-docs.py: xelatex drops missfont.log in the
# working directory, and python caches the script next to it
missfont.log
__pycache__/
